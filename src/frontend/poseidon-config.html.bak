<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Poseidon-X - LLM 配置</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
      color: #fff;
      min-height: 100vh;
      padding: 40px 20px;
    }
    .container {
      max-width: 800px;
      margin: 0 auto;
    }
    h1 {
      font-size: 32px;
      margin-bottom: 10px;
      color: #4fc3f7;
    }
    .subtitle {
      color: #888;
      margin-bottom: 40px;
    }
    .card {
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 12px;
      padding: 24px;
      margin-bottom: 24px;
    }
    .card h2 {
      font-size: 20px;
      margin-bottom: 20px;
      color: #4fc3f7;
    }
    .form-group {
      margin-bottom: 20px;
    }
    label {
      display: block;
      margin-bottom: 8px;
      font-weight: 500;
      color: #ccc;
    }
    input, select, textarea {
      width: 100%;
      padding: 12px;
      background: rgba(0,0,0,0.3);
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 8px;
      color: #fff;
      font-size: 14px;
    }
    input:focus, select:focus, textarea:focus {
      outline: none;
      border-color: #4fc3f7;
    }
    .btn {
      background: linear-gradient(135deg, #4fc3f7 0%, #2196f3 100%);
      color: #fff;
      border: none;
      padding: 14px 28px;
      border-radius: 8px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: transform 0.2s;
    }
    .btn:hover {
      transform: translateY(-2px);
    }
    .btn-secondary {
      background: rgba(255,255,255,0.1);
      margin-left: 10px;
    }
    .status {
      padding: 12px;
      border-radius: 8px;
      margin-top: 20px;
      display: none;
    }
    .status.success {
      background: rgba(76,175,80,0.2);
      border: 1px solid #4caf50;
      color: #81c784;
    }
    .status.error {
      background: rgba(244,67,54,0.2);
      border: 1px solid #f44336;
      color: #ef5350;
    }
    .provider-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 12px;
      margin-bottom: 20px;
    }
    .provider-card {
      padding: 16px;
      background: rgba(0,0,0,0.2);
      border: 2px solid transparent;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.2s;
    }
    .provider-card:hover {
      background: rgba(0,0,0,0.3);
    }
    .provider-card.selected {
      border-color: #4fc3f7;
      background: rgba(79,195,247,0.1);
    }
    .provider-card h3 {
      font-size: 16px;
      margin-bottom: 4px;
    }
    .provider-card p {
      font-size: 12px;
      color: #888;
    }
    .test-result {
      margin-top: 12px;
      padding: 8px;
      border-radius: 4px;
      font-size: 13px;
    }
    .test-result.success {
      background: rgba(76,175,80,0.2);
      color: #81c784;
    }
    .test-result.error {
      background: rgba(244,67,54,0.2);
      color: #ef5350;
    }
    .nav-strip {
      display: flex;
      gap: 12px;
      margin-bottom: 24px;
      flex-wrap: wrap;
    }
    .nav-strip a {
      color: #b3e5fc;
      text-decoration: none;
      padding: 10px 14px;
      border-radius: 999px;
      background: rgba(79,195,247,0.12);
      border: 1px solid rgba(79,195,247,0.2);
      font-size: 14px;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="nav-strip">
      <a href="/captain-cockpit.html">返回船长智能中控台</a>
      <a href="/digital-twin.html">返回数字孪生驾驶台</a>
      <a href="/index.html">返回系统首页</a>
    </div>
    <h1>🌊 Poseidon-X 配置中心</h1>
    <p class="subtitle">配置 LLM 提供商、API 密钥和智能体参数</p>
    
    <div class="card">
      <h2>🧠 LLM 提供商选择</h2>
      <div class="provider-grid">
        <div class="provider-card selected" data-provider="minimax">
          <h3>MiniMax</h3>
          <p>MiniMax-M2.5 (推荐)</p>
        </div>
        <div class="provider-card" data-provider="deepseek">
          <h3>DeepSeek</h3>
          <p>DeepSeek-V3</p>
        </div>
        <div class="provider-card" data-provider="openai">
          <h3>OpenAI</h3>
          <p>GPT-4 Turbo</p>
        </div>
        <div class="provider-card" data-provider="local">
          <h3>本地模型</h3>
          <p>Ollama / LM Studio</p>
        </div>
      </div>
      
      <div class="form-group">
        <label>API Key</label>
        <input type="password" id="apiKey" placeholder="输入你的 API 密钥">
      </div>
      
      <div class="form-group">
        <label>API Endpoint</label>
        <input type="url" id="apiEndpoint" placeholder="https://api.minimax.chat/v1">
      </div>
      
      <div class="form-group">
        <label>模型名称</label>
        <input type="text" id="model" placeholder="MiniMax-M2.5">
      </div>
      
      <div class="form-group">
        <label>Temperature (创造性)</label>
        <input type="range" id="temperature" min="0" max="2" step="0.1" value="0.7">
        <div style="text-align: right; color: #888; font-size: 12px; margin-top: 4px;">
          <span id="temperatureValue">0.7</span>
        </div>
      </div>
      
      <button class="btn" onclick="testConnection()">🔌 测试连接</button>
      <button class="btn btn-secondary" onclick="saveConfig()">💾 保存配置</button>
      
      <div id="testStatus" class="status"></div>
    </div>
    
    <div class="card">
      <h2>🤖 智能体配置</h2>
      <div class="form-group">
        <label>系统提示词 (System Prompt)</label>
        <textarea id="systemPrompt" rows="6" placeholder="你是 Poseidon-X 船舶智能系统的核心 AI 助手..."></textarea>
      </div>
      
      <div class="form-group">
        <label>最大上下文长度 (tokens)</label>
        <input type="number" id="maxContext" value="128000">
      </div>
      
      <button class="btn" onclick="saveConfig()">💾 保存配置</button>
    </div>
    
    <div class="card">
      <h2>📊 当前配置</h2>
      <pre id="currentConfig" style="background: rgba(0,0,0,0.3); padding: 16px; border-radius: 8px; overflow-x: auto; font-size: 12px;"></pre>
    </div>

    <div class="card">
      <h2>🏥 系统健康状态</h2>
      <div id="healthStatus" style="padding: 12px 0; color: #888;">加载中...</div>
    </div>

    <div class="card">
      <h2>📦 执行注册表 & ToolPool</h2>
      <div id="registryInfo" style="padding: 12px 0; color: #888;">加载中...</div>
      <div style="margin-top: 16px;">
        <button class="btn btn-secondary" onclick="testToolPool()">🏊 装配 Tool Pool</button>
        <div id="poolResult" style="margin-top: 12px;"></div>
      </div>
    </div>

    <div class="card">
      <h2>🎯 PortRuntime 路由测试</h2>
      <div class="form-group">
        <label>Prompt</label>
        <input type="text" id="rtPrompt" placeholder="例: 检查主机状态并分析油温趋势">
      </div>
      <button class="btn btn-secondary" onclick="testRouting()">🎯 路由匹配</button>
      <div id="routeResult" style="margin-top: 12px;"></div>
    </div>
  </div>
  
  <script>
    let selectedProvider = 'minimax';
    
    const providerEndpoints = {
      'minimax': 'https://api.minimax.chat/v1',
      'deepseek': 'https://api.deepseek.com/v1',
      'openai': 'https://api.openai.com/v1',
      'local': 'http://localhost:11434/v1'
    };
    
    const providerModels = {
      'minimax': 'MiniMax-M2.5',
      'deepseek': 'deepseek-chat',
      'openai': 'gpt-4-turbo-preview',
      'local': 'llama2'
    };
    
    // 初始化
    document.addEventListener('DOMContentLoaded', () => {
      loadConfig();
      setupProviderCards();
      setupTemperatureSlider();
    });
    
    function setupProviderCards() {
      document.querySelectorAll('.provider-card').forEach(card => {
        card.addEventListener('click', () => {
          document.querySelectorAll('.provider-card').forEach(c => c.classList.remove('selected'));
          card.classList.add('selected');
          selectedProvider = card.dataset.provider;
          
          document.getElementById('apiEndpoint').value = providerEndpoints[selectedProvider];
          document.getElementById('model').value = providerModels[selectedProvider];
        });
      });
    }
    
    function setupTemperatureSlider() {
      const slider = document.getElementById('temperature');
      const value = document.getElementById('temperatureValue');
      slider.addEventListener('input', () => {
        value.textContent = slider.value;
      });
    }
    
    function loadConfig() {
      // Try backend first, then localStorage fallback
      fetch('/api/v1/config/llm').then(r => r.ok ? r.json() : null).then(remote => {
        const saved = localStorage.getItem('poseidon_config');
        const config = remote || (saved ? JSON.parse(saved) : null);
        if (!config) return;

        document.querySelectorAll('.provider-card').forEach(c => {
          c.classList.toggle('selected', c.dataset.provider === config.llmProvider);
        });
        selectedProvider = config.llmProvider || 'minimax';

        document.getElementById('apiKey').value = config.apiKey || '';
        document.getElementById('apiEndpoint').value = config.apiEndpoint || providerEndpoints[selectedProvider];
        document.getElementById('model').value = config.model || providerModels[selectedProvider];
        document.getElementById('temperature').value = config.temperature || 0.7;
        document.getElementById('temperatureValue').textContent = config.temperature || 0.7;
        document.getElementById('systemPrompt').value = config.systemPrompt || '';
        document.getElementById('maxContext').value = config.maxContextTokens || 128000;

        showCurrentConfig(config);
      }).catch(() => {
        // Offline fallback
        try {
          const saved = localStorage.getItem('poseidon_config');
          if (saved) {
            const config = JSON.parse(saved);
            document.querySelectorAll('.provider-card').forEach(c => {
              c.classList.toggle('selected', c.dataset.provider === config.llmProvider);
            });
            selectedProvider = config.llmProvider || 'minimax';
            document.getElementById('apiKey').value = config.apiKey || '';
            document.getElementById('apiEndpoint').value = config.apiEndpoint || providerEndpoints[selectedProvider];
            document.getElementById('model').value = config.model || providerModels[selectedProvider];
            document.getElementById('temperature').value = config.temperature || 0.7;
            document.getElementById('temperatureValue').textContent = config.temperature || 0.7;
            document.getElementById('systemPrompt').value = config.systemPrompt || '';
            document.getElementById('maxContext').value = config.maxContextTokens || 128000;
            showCurrentConfig(config);
          }
        } catch (error) {
          console.error('加载配置失败:', error);
        }
      });
    }
    
    function saveConfig() {
      const config = {
        llmProvider: selectedProvider,
        apiKey: document.getElementById('apiKey').value,
        apiEndpoint: document.getElementById('apiEndpoint').value,
        model: document.getElementById('model').value,
        temperature: parseFloat(document.getElementById('temperature').value),
        systemPrompt: document.getElementById('systemPrompt').value,
        maxContextTokens: parseInt(document.getElementById('maxContext').value)
      };
      
      localStorage.setItem('poseidon_config', JSON.stringify(config));
      showCurrentConfig(config);
      
      // Persist to backend
      fetch('/api/v1/config/llm', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(config)
      }).then(r => r.json()).then(d => {
        showStatus('✅ 配置已保存至服务器 (' + (d.path || 'ok') + ')', 'success');
      }).catch(() => {
        showStatus('✅ 配置已保存到本地 (后端不可达)', 'success');
      });
      
      // 广播配置更新事件
      window.postMessage({ type: 'POSEIDON_CONFIG_UPDATED', config }, '*');
    }
    
    async function testConnection() {
      const status = document.getElementById('testStatus');
      status.style.display = 'block';
      status.className = 'status';
      status.textContent = '🔄 正在测试连接...';
      
      const config = {
        provider: selectedProvider,
        name: document.getElementById('model').value,
        api_key: document.getElementById('apiKey').value,
        api_base_url: document.getElementById('apiEndpoint').value,
        max_tokens: parseInt(document.getElementById('maxContext').value) || 4096,
        temperature: parseFloat(document.getElementById('temperature').value) || 0.7,
      };
      
      try {
        // Use the backend test-model endpoint
        const response = await fetch('/api/v1/agent-config/llm/test-model', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(config),
        });
        
        if (response.ok) {
          const result = await response.json();
          if (result.success) {
            status.textContent = `✅ 连接成功！模型: ${result.model}, 延迟: ${Math.round(result.latency_ms)}ms\n回复: ${result.response}`;
            status.className = 'status success';
          } else {
            status.textContent = `⚠️ 连接失败: ${result.error || '未知错误'}`;
            status.className = 'status error';
          }
        } else {
          // Fallback to local test
          if (config.api_key) {
            status.textContent = `✅ API Key 已配置 (${config.provider})，后端不可达时将在下次启动验证`;
            status.className = 'status success';
          } else {
            status.textContent = '⚠️ API Key 未配置';
            status.className = 'status error';
          }
        }
      } catch (error) {
        // Offline fallback
        if (config.api_key) {
          status.textContent = `✅ API Key 已配置 (${config.provider})，后端离线`;
          status.className = 'status success';
        } else {
          status.textContent = `⚠️ 后端不可达: ${error.message}`;
          status.className = 'status error';
        }
      }
    }
    
    function showCurrentConfig(config) {
      const display = {
        ...config,
        apiKey: config.apiKey ? '••••••' + config.apiKey.slice(-4) : '(未配置)'
      };
      document.getElementById('currentConfig').textContent = JSON.stringify(display, null, 2);
    }
    
    function showStatus(message, type) {
      const status = document.getElementById('testStatus');
      status.style.display = 'block';
      status.textContent = message;
      status.className = `status ${type}`;
      setTimeout(() => {
        status.style.display = 'none';
      }, 5000);
    }

    // ── System Health ──
    async function loadSystemHealth() {
      try {
        const [health, registry] = await Promise.all([
          fetch('/api/v1/agent-config/health').then(r => r.ok ? r.json() : null).catch(() => null),
          fetch('/api/v1/agent-config/execution-registry').then(r => r.ok ? r.json() : null).catch(() => null)
        ]);

        const el = document.getElementById('healthStatus');
        if (!health) { el.innerHTML = '<span style="color:#ef5350">后端不可达</span>'; return; }
        const st = health.status || 'unknown';
        const color = (st === 'ok' || st === 'healthy') ? '#81c784' : st === 'degraded' ? '#ffb74d' : '#ef5350';
        let html = `<div style="margin-bottom:8px"><span style="color:${color};font-weight:600">● ${st.toUpperCase()}</span></div>`;
        if (health.channels) { html += `<div>Channels: ${health.channels.ok||0}/${health.channels.total||0} 正常</div>`; }
        if (health.uptime_seconds) {
          const h = Math.floor(health.uptime_seconds / 3600);
          const m = Math.floor((health.uptime_seconds % 3600) / 60);
          html += `<div>运行时间: ${h}h ${m}m</div>`;
        }
        el.innerHTML = html;

        const regEl = document.getElementById('registryInfo');
        if (registry) {
          regEl.innerHTML = `<div style="margin-bottom:8px"><strong>工具:</strong> ${registry.tool_count} 个 | <strong>命令:</strong> ${registry.command_count} 个</div>` +
            `<div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:8px">${(registry.tools||[]).slice(0,15).map(t => `<span style="padding:3px 8px;border-radius:4px;background:rgba(79,195,247,0.1);border:1px solid rgba(79,195,247,0.2);font-size:11px">${t}</span>`).join('')}${registry.tool_count > 15 ? '<span style="color:#888;font-size:11px">...等</span>' : ''}</div>`;
        } else {
          regEl.innerHTML = '<span style="color:#888">注册表数据不可用</span>';
        }
      } catch (e) { console.warn('Health check failed:', e); }
    }

    async function testToolPool() {
      const el = document.getElementById('poolResult');
      el.innerHTML = '<span style="color:#888">装配中...</span>';
      try {
        const r = await fetch('/api/v1/agent-config/tool-pool', {
          method: 'POST', headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({simple_mode: false, include_mcp: true, deny_tools: [], deny_prefixes: []})
        });
        if (!r.ok) { el.innerHTML = '<span style="color:#ef5350">请求失败</span>'; return; }
        const d = await r.json();
        el.innerHTML = `<div class="test-result success">✅ Tool Pool: ${d.count} 个工具</div>` +
          `<div style="display:flex;gap:4px;flex-wrap:wrap;margin-top:8px">${(d.tools||[]).map(t => `<span style="padding:2px 6px;border-radius:3px;background:rgba(76,175,80,0.15);font-size:11px;color:#81c784">${t}</span>`).join('')}</div>`;
      } catch (e) { el.innerHTML = `<span style="color:#ef5350">错误: ${e.message}</span>`; }
    }

    async function testRouting() {
      const prompt = document.getElementById('rtPrompt').value.trim();
      if (!prompt) { return; }
      const el = document.getElementById('routeResult');
      el.innerHTML = '<span style="color:#888">路由中...</span>';
      try {
        const r = await fetch('/api/v1/agent-config/runtime/route', {
          method: 'POST', headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({prompt, limit: 5, deny_tools: [], deny_prefixes: []})
        });
        if (!r.ok) { el.innerHTML = '<span style="color:#ef5350">路由失败</span>'; return; }
        const d = await r.json();
        if (!d.matches || !d.matches.length) { el.innerHTML = '<div class="test-result error">未找到匹配</div>'; return; }
        el.innerHTML = `<div class="test-result success">✅ 匹配到 ${d.count} 个工具/命令</div>` +
          `<table style="width:100%;margin-top:8px;font-size:12px"><tr style="color:#888"><td>类型</td><td>名称</td><td>来源</td><td>得分</td></tr>${d.matches.map(m => `<tr><td style="padding:4px 0"><span style="padding:2px 6px;border-radius:3px;background:${m.kind==='tool'?'rgba(76,175,80,0.15)':'rgba(79,195,247,0.15)'};font-size:10px">${m.kind}</span></td><td style="font-weight:600">${m.name}</td><td style="color:#888">${m.source_hint||'-'}</td><td style="font-family:monospace">${m.score.toFixed(2)}</td></tr>`).join('')}</table>`;
      } catch (e) { el.innerHTML = `<span style="color:#ef5350">错误: ${e.message}</span>`; }
    }

    // Load system health on page load 
    loadSystemHealth();
    setInterval(loadSystemHealth, 30000);
  </script>
</body>
</html>
