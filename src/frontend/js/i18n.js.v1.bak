/**
 * PoseidonX — i18n Internationalization Module
 * Supports zh (Chinese) and en (English) switching.
 * Usage: <script src="/js/i18n.js"></script>
 * Pages register translations via window.PX_I18N.register({ key: { zh, en } })
 * Elements with data-i18n="key" are auto-translated.
 */
(function () {
  'use strict';

  const LANGS = ['zh', 'en'];
  const STORAGE_KEY = 'px-lang';

  // ── Core translation dictionary (shared across all pages) ──
  const DICT = {
    // Nav sidebar
    'nav.captain':     { zh: '船长总览', en: 'Captain' },
    'nav.navigation':  { zh: '导航',   en: 'Navigation' },
    'nav.dp':          { zh: '动力定位', en: 'DP Control' },
    'nav.thruster':    { zh: '推进控制', en: 'Thruster' },
    'nav.monitor':     { zh: '全船监控', en: 'Monitor' },
    'nav.cms':         { zh: '设备健康', en: 'CMS Health' },
    'nav.hmi':         { zh: '控制台',  en: 'HMI Console' },
    'nav.offshore':    { zh: '海工作业', en: 'Offshore Ops' },
    'nav.weather':     { zh: '气象海洋', en: 'Weather' },
    'nav.crew':        { zh: '船员管理', en: 'Crew Mgmt' },
    'nav.sim':         { zh: '仿真训练', en: 'Simulation' },
    'nav.energy':      { zh: '能效合规', en: 'Energy' },
    'nav.datacenter':  { zh: '船载数据中心', en: 'Datacenter' },
    'nav.safety':      { zh: '安全应急', en: 'Safety' },
    'nav.shore':       { zh: '船岸协同', en: 'Ship-Shore' },
    'nav.twin':        { zh: '数字孪生', en: 'Digital Twin' },
    'nav.agents':      { zh: '智能体',  en: 'AI Agents' },
    'nav.evolution':   { zh: '系统演进', en: 'Evolution' },
    'nav.kb':          { zh: '知识库',  en: 'Knowledge' },
    'nav.llm-config':  { zh: 'LLM 配置', en: 'LLM Config' },

    // Common UI
    'ui.search':       { zh: '搜索',   en: 'Search' },
    'ui.save':         { zh: '保存',   en: 'Save' },
    'ui.cancel':       { zh: '取消',   en: 'Cancel' },
    'ui.confirm':      { zh: '确认',   en: 'Confirm' },
    'ui.close':        { zh: '关闭',   en: 'Close' },
    'ui.refresh':      { zh: '刷新',   en: 'Refresh' },
    'ui.export':       { zh: '导出',   en: 'Export' },
    'ui.status':       { zh: '状态',   en: 'Status' },
    'ui.settings':     { zh: '设置',   en: 'Settings' },
    'ui.loading':      { zh: '加载中…', en: 'Loading…' },
    'ui.connected':    { zh: '已连接',  en: 'Connected' },
    'ui.offline':      { zh: '离线',   en: 'Offline' },
    'ui.alarm':        { zh: '报警',   en: 'Alarm' },
    'ui.warning':      { zh: '警告',   en: 'Warning' },
    'ui.normal':       { zh: '正常',   en: 'Normal' },
    'ui.language':     { zh: '中/EN',  en: 'EN/中' },
  };

  function getLang() {
    const saved = localStorage.getItem(STORAGE_KEY);
    return (saved && LANGS.includes(saved)) ? saved : 'zh';
  }

  function setLang(lang) {
    if (!LANGS.includes(lang)) return;
    localStorage.setItem(STORAGE_KEY, lang);
    applyAll();
    // Dispatch event for page-specific handlers
    window.dispatchEvent(new CustomEvent('px-lang-change', { detail: { lang } }));
  }

  function toggleLang() {
    const cur = getLang();
    setLang(cur === 'zh' ? 'en' : 'zh');
  }

  function t(key) {
    const entry = DICT[key];
    if (!entry) return key;
    return entry[getLang()] || entry.zh || key;
  }

  function register(translations) {
    // Merge page-specific translations into DICT
    for (const [key, val] of Object.entries(translations)) {
      DICT[key] = val;
    }
  }

  function applyAll() {
    const lang = getLang();
    // Update all elements with data-i18n attribute
    document.querySelectorAll('[data-i18n]').forEach(el => {
      const key = el.getAttribute('data-i18n');
      const entry = DICT[key];
      if (entry) {
        el.textContent = entry[lang] || entry.zh || el.textContent;
      }
    });
    // Update all elements with data-i18n-title attribute
    document.querySelectorAll('[data-i18n-title]').forEach(el => {
      const key = el.getAttribute('data-i18n-title');
      const entry = DICT[key];
      if (entry) {
        el.title = entry[lang] || entry.zh || el.title;
      }
    });
    // Update all elements with data-i18n-placeholder attribute
    document.querySelectorAll('[data-i18n-placeholder]').forEach(el => {
      const key = el.getAttribute('data-i18n-placeholder');
      const entry = DICT[key];
      if (entry) {
        el.placeholder = entry[lang] || entry.zh || el.placeholder;
      }
    });
    // Update html lang attribute
    document.documentElement.lang = lang === 'zh' ? 'zh-CN' : 'en';
    // Update language toggle button text
    const btn = document.getElementById('px-lang-btn');
    if (btn) btn.textContent = lang === 'zh' ? '中/EN' : 'EN/中';
  }

  // Expose global API
  window.PX_I18N = {
    t,
    getLang,
    setLang,
    toggleLang,
    register,
    applyAll,
    DICT
  };

  // Auto-apply on DOM ready
  function onReady() { applyAll(); }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', onReady);
  } else {
    onReady();
  }
})();
