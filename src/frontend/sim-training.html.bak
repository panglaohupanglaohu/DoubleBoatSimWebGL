<!DOCTYPE html><html lang="zh-CN" data-obc-theme="dusk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<meta name="ob-title" content="仿真训练">
<meta name="ob-subtitle" content="K-Sim Navigation — 训练仿真与评估">
<title>仿真训练 — PoseidonX</title>

<link rel="stylesheet" href="/css/openbridge-theme.css">
<style>
.sim-layout{display:grid;grid-template-columns:1fr 340px;gap:16px;padding:16px}
.radar-canvas{width:100%;aspect-ratio:1;background:var(--ob-bg-section);border-radius:var(--ob-radius-lg)}
.stats-row{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:16px}
.stat-big{text-align:center;padding:16px}
.stat-big .val{font-size:36px;font-weight:700;color:var(--ob-accent)}
.stat-big .lbl{font-size:12px;color:var(--ob-text-tertiary);margin-top:4px}
.ctrl-btns{display:flex;gap:10px;margin-top:16px}
.ctrl-btns button{flex:1;padding:12px;border:none;border-radius:var(--ob-radius-sm);font-size:14px;font-weight:600;cursor:pointer}
.btn-start{background:var(--ob-running);color:#fff}
.btn-pause{background:var(--ob-warning);color:#000}
.btn-reset{background:var(--ob-bg-section);color:var(--ob-text-primary);border:1px solid var(--ob-border) !important}
.toggle-row{display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--ob-border)}
.toggle-row:last-child{border-bottom:none}
.toggle-switch{width:42px;height:22px;background:var(--ob-bg-section);border-radius:11px;position:relative;cursor:pointer;transition:.3s}
.toggle-switch.on{background:var(--ob-alarm)}
.toggle-switch::after{content:"";position:absolute;top:2px;left:2px;width:18px;height:18px;background:#fff;border-radius:50%;transition:.3s}
.toggle-switch.on::after{left:22px}
.form-group{margin-bottom:12px}
.form-group label{display:block;font-size:12px;color:var(--ob-text-tertiary);margin-bottom:4px}
.form-group select,.form-group input{width:100%;padding:8px;background:var(--ob-bg-section);color:var(--ob-text-primary);border:1px solid var(--ob-border);border-radius:var(--ob-radius-sm)}
</style>
</head>
<body>
<div class="sim-layout">
<div class="sim-left">
<div class="ob-card"><div class="ob-card-header"><span class="ob-card-title">场景配置</span></div><div class="ob-card-body">
<div class="form-group"><label>天气</label><select><option>晴朗</option><option>多云</option><option>暴雨</option><option>台风</option></select></div>
<div class="form-group"><label>海况 (蒲氏风级)</label><select><option>3 — 轻浪</option><option>5 — 大浪</option><option>7 — 狂浪</option><option>9 — 狂涛</option></select></div>
<div class="form-group"><label>交通密度</label><select><option>低 (≤5船)</option><option>中 (6-15船)</option><option>高 (&gt;15船)</option></select></div>
<div class="form-group"><label>能见度 (nm)</label><input type="number" value="5" min="0.1" max="20" step="0.1"></div>
<div class="form-group"><label>模拟时间</label><input type="datetime-local" value="2026-04-01T08:00"></div>
</div></div>
<div class="ob-card" style="margin-top:16px"><div class="ob-card-header"><span class="ob-card-title">故障注入</span></div><div class="ob-card-body">
<div class="toggle-row"><span>主机故障</span><div class="toggle-switch" onclick="this.classList.toggle('on')"></div></div>
<div class="toggle-row"><span>舵机故障</span><div class="toggle-switch" onclick="this.classList.toggle('on')"></div></div>
<div class="toggle-row"><span>GPS 失锁</span><div class="toggle-switch" onclick="this.classList.toggle('on')"></div></div>
<div class="toggle-row"><span>雷达故障</span><div class="toggle-switch" onclick="this.classList.toggle('on')"></div></div>
<div class="toggle-row"><span>通信中断</span><div class="toggle-switch" onclick="this.classList.toggle('on')"></div></div>
<div class="toggle-row"><span>电力丧失</span><div class="toggle-switch" onclick="this.classList.toggle('on')"></div></div>
</div></div>
<div class="ob-card" style="margin-top:16px"><div class="ob-card-header"><span class="ob-card-title">训练日志</span></div><div class="ob-card-body">
<table class="ob-table"><thead><tr><th>时间</th><th>事件</th><th>评价</th></tr></thead><tbody>
<tr><td>08:05</td><td>避让右舷目标船</td><td><span class="ob-badge ob-badge-ok">优秀</span></td></tr>
<tr><td>08:12</td><td>雷达标绘 ARPA</td><td><span class="ob-badge ob-badge-ok">合格</span></td></tr>
<tr><td>08:20</td><td>VHF 联络确认</td><td><span class="ob-badge ob-badge-warning">延迟</span></td></tr>
<tr><td>08:31</td><td>狭水道操纵</td><td><span class="ob-badge ob-badge-ok">合格</span></td></tr>
<tr><td>08:45</td><td>应急舵切换</td><td><span class="ob-badge ob-badge-alarm">失败</span></td></tr>
</tbody></table></div></div>
</div>
<div class="sim-right">
<div class="ob-card"><div class="ob-card-header"><span class="ob-card-title">能力评分</span></div>
<div class="ob-card-body"><canvas id="radarChart" class="radar-canvas"></canvas></div></div>
<div class="ob-card" style="margin-top:16px"><div class="ob-card-header"><span class="ob-card-title">成绩统计</span></div><div class="ob-card-body">
<div class="stats-row"><div class="stat-big"><div class="val">85</div><div class="lbl">总分</div></div>
<div class="stat-big"><div class="val">3</div><div class="lbl">排名</div></div>
<div class="stat-big"><div class="val">12.5h</div><div class="lbl">累计时长</div></div></div>
</div></div>
<div class="ctrl-btns"><button class="btn-start">&#9654; 开始</button><button class="btn-pause">&#9198; 暂停</button><button class="btn-reset">&#8634; 重置</button></div>
</div></div>
<script>
(function(){
  var c=document.getElementById('radarChart'),ctx=c.getContext('2d');
  var currentScores={};
  function draw(scores){
    var W=c.width=c.offsetWidth,H=c.height=c.offsetHeight;
    var cx=W/2,cy=H/2,r=Math.min(W,H)/2-30;
    var labels=Object.keys(scores||currentScores||{'避碰':0.9,'导航':0.8,'通信':0.7,'应急':0.6,'操纵':0.85});
    var vals=Object.values(scores||currentScores||{'避碰':0.9,'导航':0.8,'通信':0.7,'应急':0.6,'操纵':0.85});
    var n=labels.length,step=Math.PI*2/n,start=-Math.PI/2;
    ctx.clearRect(0,0,W,H);
    for(var g=1;g<=5;g++){ctx.beginPath();for(var i=0;i<=n;i++){var a=start+i*step;ctx.lineTo(cx+r*g/5*Math.cos(a),cy+r*g/5*Math.sin(a));}ctx.closePath();ctx.strokeStyle='rgba(255,255,255,0.1)';ctx.stroke();}
    ctx.beginPath();vals.forEach(function(s,i){var a=start+i*step;if(i===0)ctx.moveTo(cx+r*s*Math.cos(a),cy+r*s*Math.sin(a));else ctx.lineTo(cx+r*s*Math.cos(a),cy+r*s*Math.sin(a));});
    ctx.closePath();ctx.fillStyle='rgba(0,160,255,0.25)';ctx.fill();ctx.strokeStyle='#00a0ff';ctx.lineWidth=2;ctx.stroke();
    ctx.fillStyle='#ccc';ctx.font='13px sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';
    labels.forEach(function(l,i){var a=start+i*step;ctx.fillText(l,cx+(r+20)*Math.cos(a),cy+(r+20)*Math.sin(a));});
  }
  draw();window.addEventListener('resize',function(){draw();});

  // Fetch scores
  function fetchScores(){
    fetch('/api/v1/sim/scores').then(function(r){return r.json();}).then(function(d){
      if(d.scores){currentScores=d.scores;draw(d.scores);}
      var statVals=document.querySelectorAll('.stat-big .val');
      if(statVals[0])statVals[0].textContent=Math.round((d.overall||0.8)*100);
    }).catch(function(){});
  }
  fetchScores();setInterval(fetchScores,10000);

  // Fetch training log
  function fetchLog(){
    fetch('/api/v1/sim/training-log').then(function(r){return r.json();}).then(function(d){
      var tbody=document.querySelector('.sim-left .ob-card:last-child tbody');
      if(!tbody||!d.log)return;
      tbody.innerHTML='';
      d.log.slice(-5).forEach(function(e){
        var time=e.time?new Date(e.time).toLocaleTimeString('zh-CN',{hour:'2-digit',minute:'2-digit'}):'';
        tbody.innerHTML+='<tr><td>'+time+'</td><td>'+(e.event||'')+'</td><td><span class="ob-badge ob-badge-neutral">—</span></td></tr>';
      });
    }).catch(function(){});
  }
  fetchLog();setInterval(fetchLog,8000);

  // Control buttons
  document.querySelector('.btn-start').addEventListener('click',function(){
    var weather=document.querySelector('.form-group select').value;
    fetch('/api/v1/sim/scenario',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({scenario:'COLREGs',difficulty:'medium'})}).then(function(){fetchLog();fetchScores();});
  });

  // Fault injection toggles
  var faultSystems=['engine','rudder','gps','radar','comms','power'];
  document.querySelectorAll('.toggle-switch').forEach(function(sw,i){
    sw.addEventListener('click',function(){
      this.classList.toggle('on');
      var sys=faultSystems[i]||'unknown';
      if(this.classList.contains('on')){
        fetch('/api/v1/sim/inject-fault',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({system:sys,fault_type:'degraded'})}).then(function(){fetchLog();});
      }
    });
  });
})();
</script>
<script src="/js/nav-sidebar.js" data-active="sim"></script>
<script>(function(){var P="ws://"+location.host+"/ws/sim";var ws,t;function C(){ws=new WebSocket(P);ws.onclose=function(){clearTimeout(t);t=setTimeout(C,3e3)};ws.onerror=function(){ws.close()}}C()})();</script>
</body>
</html>